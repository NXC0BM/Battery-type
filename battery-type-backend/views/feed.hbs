<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <title>AMPHOUR — Лента</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <div class="screen feed-screen">
    <div class="feed-media">
      <!-- video тег ссылается на файл в Minio по videoUrl -->
      <video autoplay muted loop playsinline poster="{{accumulator.imageUrl}}">
        <source src="{{accumulator.videoUrl}}" type="video/mp4" />
      </video>
      <div class="feed-overlay">
        <span class="feed-badge">{{accumulator.chemistryType}}</span>
        <div class="feed-title">{{accumulator.modelName}}</div>
        <div class="feed-specs">{{accumulator.capacityMah}} мА·ч · {{accumulator.nominalVoltageV}} В</div>
        <div class="feed-desc">
          {{accumulator.description}} <a href="#">Ещё</a>
        </div>
        <div class="feed-row">
          <a class="like-btn" href="#">
            <span class="heart">♥</span>
            <span>{{accumulator.likesCount}}</span>
          </a>
          <a class="next-btn" href="/01-lenta/{{accumulator.id}}?next=true">→</a>
        </div>
      </div>
    </div>

    <nav class="tabbar">
      <a class="active" href="/01-lenta">
        <span class="icon">▶</span>Лента
      </a>
      <a href="/02-dobavlenie">
        <span class="icon">+</span>Добавление
      </a>
      <a href="/03-plitka">
        <span class="icon">▦</span>Плитка
      </a>
    </nav>
  </div>
</body>
</html>
