<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <title>Battery Type — Лента</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <div class="screen feed-screen">
    <div class="feed-media">
      <!-- video тег ссылается на файл в Minio по videoUrl -->
      <video autoplay muted loop playsinline poster="{{battery_type.imageUrl}}">
        <source src="{{battery_type.videoUrl}}" type="video/mp4" />
      </video>
      <div class="feed-overlay">
        <span class="feed-badge">{{battery_type.chemistryType}}</span>
        <div class="feed-title">{{battery_type.modelName}}</div>
        <div class="feed-specs">{{battery_type.capacityMah}} мА·ч · {{battery_type.nominalVoltageV}} В</div>
        <div class="feed-desc">
          {{battery_type.description}} <a href="#">Ещё</a>
        </div>
        <div class="feed-row">
          <a class="like-btn" href="#">
            <span class="heart">♥</span>
            <span>{{battery_type.likesCount}}</span>
          </a>
          <a class="next-btn" href="/battery_type/feed/{{battery_type.id}}?next=true">→</a>
        </div>
      </div>
    </div>

    <nav class="tabbar">
      <a class="active" href="/battery_type/feed">
        <span class="icon">▶</span>Лента
      </a>
      <a href="/battery_type/draft">
        <span class="icon">+</span>Добавление
      </a>
      <a href="/battery_type">
        <span class="icon">▦</span>Плитка
      </a>
    </nav>
  </div>
</body>
</html>
