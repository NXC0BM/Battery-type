<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <title>AMPHOUR — Добавление</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <div class="screen">
    <div class="app-header">
      <div class="brand">AMPHOUR</div>
      <div class="brand-sub">Расчёт времени работы</div>
      <h1>Добавление <span class="draft-badge">Черновик</span></h1>
    </div>

    {{#unless draft}}
      <p style="padding: 0 16px; color: #767676;">Укажите название, фото и видео.</p>
      <form method="POST" action="/02-dobavlenie/next">
        <div class="draft-field">
          <label>Название модели</label>
          <input type="text" name="modelName" required style="width:100%;border:none;font-size:15px;">
        </div>
        <div class="draft-field">
          <label>Фото</label>
          <input type="file" disabled>
          <div style="font-size:11px;color:#aaa;">(в этой лабораторной не сохраняется)</div>
        </div>
        <div class="draft-field">
          <label>Видео</label>
          <input type="file" disabled>
          <div style="font-size:11px;color:#aaa;">(в этой лабораторной не сохраняется)</div>
        </div>
        <div style="padding: 0 16px;">
          <button class="filter-submit" type="submit">Далее</button>
        </div>
      </form>
    {{else}}
      <p style="padding: 0 16px; color: #767676;">{{draft.modelName}}</p>
      <form method="POST" action="/02-dobavlenie/publish">
        <div class="draft-field">
          <label>Краткое описание</label>
          <input type="text" name="shortDescription" required style="width:100%;border:none;font-size:15px;">
        </div>
        <div class="draft-field">
          <label>Ёмкость, мА·ч</label>
          <input type="number" name="capacityMah" required style="width:100%;border:none;font-size:15px;">
        </div>
        <div class="draft-field">
          <label>Напряжение, В</label>
          <input type="number" step="0.1" name="nominalVoltageV" required style="width:100%;border:none;font-size:15px;">
        </div>
        <div style="padding: 0 16px;">
          <button class="filter-submit" type="submit">Опубликовать</button>
        </div>
      </form>
    {{/unless}}

    <nav class="tabbar">
      <a href="/01-lenta"><span class="icon">▶</span>Лента</a>
      <a class="active" href="/02-dobavlenie"><span class="icon">+</span>Добавление</a>
      <a href="/03-plitka"><span class="icon">▦</span>Плитка</a>
    </nav>
  </div>
</body>
</html>
