<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <title>Battery Type — Лента</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <div class="screen feed-screen">
    {{#if battery_type}}
      <div class="feed-media">
        <video autoplay muted loop playsinline poster="{{#if battery_type.imageUrl}}{{battery_type.imageUrl}}{{else}}/img/default-battery_type.jpg{{/if}}">
          <source src="{{#if battery_type.videoUrl}}{{battery_type.videoUrl}}{{else}}/img/default-battery_type.mp4{{/if}}" type="video/mp4" />
        </video>
        <div class="feed-overlay">
          <div class="feed-title">{{battery_type.modelName}}</div>
          <div class="feed-specs">{{battery_type.capacityMah}} мА·ч · {{battery_type.nominalVoltageV}} В</div>
          <div class="feed-desc">{{battery_type.shortDescription}}</div>
          <div class="feed-row">
            <div class="like-btn">
              <span class="heart">♥</span>
              <span>{{battery_type.likesCount}}</span>
            </div>
            <a class="next-btn" href="/battery_type/feed/{{battery_type.id}}?next=true">→</a>
          </div>
        </div>
      </div>
    {{else}}
      <p style="padding:16px;color:#767676;">Нет опубликованных аккумуляторов.</p>
    {{/if}}

    <nav class="tabbar">
      <a class="active" href="/battery_type/feed"><span class="icon">▶</span>Лента</a>
      <a href="/battery_type/draft"><span class="icon">+</span>Добавление</a>
      <a href="/battery_type"><span class="icon">▦</span>Плитка</a>
    </nav>
  </div>
</body>
</html>
