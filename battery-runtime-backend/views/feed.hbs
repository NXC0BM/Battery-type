<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <title>Battery Runtime — Лента</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <div class="screen feed-screen">
    {{#if accumulator}}
      <div class="feed-media">
        <video autoplay muted loop playsinline poster="{{#if accumulator.imageUrl}}{{accumulator.imageUrl}}{{else}}/img/default-accumulator.jpg{{/if}}">
          <source src="{{#if accumulator.videoUrl}}{{accumulator.videoUrl}}{{else}}/img/default-accumulator.mp4{{/if}}" type="video/mp4" />
        </video>
        <div class="feed-overlay">
          <div class="feed-title">{{accumulator.modelName}}</div>
          <div class="feed-specs">{{accumulator.capacityMah}} мА·ч · {{accumulator.nominalVoltageV}} В</div>
          <div class="feed-desc">{{accumulator.shortDescription}}</div>
          {{#if accumulator.attributes.length}}
          <ul class="feed-attrs">
            {{#each accumulator.attributes}}
            <li><span class="attr-name">{{this.name}}</span><span class="attr-value">{{this.value}}{{#if this.unit}} {{this.unit}}{{/if}}</span></li>
            {{/each}}
          </ul>
          {{/if}}
          <div class="feed-row">
            <div class="like-btn">
              <span class="heart">♥</span>
              <span>{{accumulator.likesCount}}</span>
            </div>
            <a class="next-btn" href="/01-lenta/{{accumulator.id}}?next=true">→</a>
          </div>
        </div>
      </div>
    {{else}}
      <p style="padding:16px;color:#767676;">Нет опубликованных аккумуляторов.</p>
    {{/if}}

    <nav class="tabbar">
      <a class="active" href="/01-lenta"><span class="icon">▶</span>Лента</a>
      <a href="/02-dobavlenie"><span class="icon">+</span>Добавление</a>
      <a href="/03-plitka"><span class="icon">▦</span>Плитка</a>
    </nav>
  </div>
</body>
</html>
