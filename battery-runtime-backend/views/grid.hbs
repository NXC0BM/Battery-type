<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <title>AMPHOUR — Плитка</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <div class="screen">
    <div class="app-header">
      <div class="brand">AMPHOUR</div>
      <div class="brand-sub">Расчёт времени работы</div>
      <h1>Аккумуляторы</h1>
      <p class="subtitle">Каталог типов аккумуляторов</p>
    </div>

    <form class="filter-section" method="GET" action="/03-plitka">
      <div class="filter-label">Ёмкость, мА·ч</div>
      <div class="filter-row">
        <input
          type="range"
          name="minCapacityMah"
          min="1000"
          max="5000"
          step="100"
          value="{{#if currentMinCapacityMah}}{{currentMinCapacityMah}}{{else}}1000{{/if}}"
        />
        <span class="filter-value">
          {{#if currentMinCapacityMah}}{{currentMinCapacityMah}}{{else}}1000{{/if}}
        </span>
      </div>
      <button class="filter-submit" type="submit">Фильтровать</button>
    </form>

    <div class="grid">
      {{#each accumulators}}
        <div class="acc-card-wrapper">
          <a class="acc-card" href="/01-lenta/{{this.id}}">
            <div class="acc-thumb" style="background-image: url('{{#if this.imageUrl}}{{this.imageUrl}}{{else}}/img/default-accumulator.jpg{{/if}}')"></div>
            <div class="acc-name">{{this.modelName}}</div>
            <div class="acc-meta">
              <span class="capacity">{{this.capacityMah}} мА·ч</span>
              <span>♥ {{this.likesCount}}</span>
            </div>
          </a>
          <form action="/03-plitka/delete" method="POST" class="delete-form">
            <input type="hidden" name="id" value="{{this.id}}">
            <button type="submit" class="delete-btn">✕</button>
          </form>
        </div>
      {{/each}}
    </div>

    <nav class="tabbar">
      <a href="/01-lenta"><span class="icon">▶</span>Лента</a>
      <a href="/02-dobavlenie"><span class="icon">+</span>Добавление</a>
      <a class="active" href="/03-plitka"><span class="icon">▦</span>Плитка</a>
    </nav>
  </div>
</body>
</html>
